# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/

# Data: only what the pipeline reads is committed (CPCB 2018-2025, the CAMS daily series, ERA5,
# the adapted second dataset). Everything else is large and re-downloadable with scripts/.
data/raw/*
!data/raw/era5_delhi_blh.csv
!data/raw/delhi_cpcb/
data/raw/delhi_cpcb/*
!data/raw/delhi_cpcb/20[12][0-9]/
data/raw/delhi_cpcb/201[0-7]/
data/raw/delhi_cpcb/2026/
!data/raw/delhi_cpcb/README.md
!data/raw/delhi_cpcb/DATA_DICTIONARY.md
!data/raw/delhi_cpcb/STATION_COVERAGE.csv
!data/raw/cams/
data/raw/cams/*
!data/raw/cams/cams_daily_delhi.csv
data/interim/
data/processed/*
!data/processed/vopani_delhi/

# Pipeline outputs (regenerated by every run)
runs/

